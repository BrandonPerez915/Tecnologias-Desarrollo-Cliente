# Copia este archivo como .env y llena los valores, .env nunca se sube al repo

# Puerto de la API Express
PORT=3000

# Llave para firmar los JWT, usa una cadena larga y aleatoria
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tiempo de vida del token (formato de jsonwebtoken: 30m, 2h, 1d)
JWT_EXPIRES_IN=2h
